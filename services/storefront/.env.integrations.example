# Copy to .env.integrations. File paths contain no credentials.
# Use compose.auth.yaml for MAIL_ENABLED / MAIL_FROM in both processes.
# Mount only independently configured integration credentials into /run/integrations.
ORDER_TESTING_ENABLED=false
LEGACY_BUYER_COOKIE_ENABLED=false
ALIPAY_ENABLED=false
PAYMENT_CHECKOUT_ENABLED=false
PAYMENT_TEST_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_APP_PRIVATE_KEY_FILE=/run/integrations/alipay-private
ALIPAY_PUBLIC_KEY_FILE=/run/integrations/alipay-public
# Enable only after all three GATEWAYA merchant credentials are installed.
GATEWAYA_ENABLED=false
GATEWAYA_PID=
GATEWAYA_PRIVATE_KEY_FILE=/run/integrations/gatewaya-private
GATEWAYA_PUBLIC_KEY_FILE=/run/integrations/gatewaya-public
GATEWAYB_ENABLED=false
GATEWAYB_PID=
GATEWAYB_KEY_FILE=/run/integrations/gatewayb-key
# Optional channel IDs, otherwise merchant default channel.
GATEWAYB_ALIPAY_CID=
GATEWAYB_WXPAY_CID=
PAYMENT_NOTIFY_ORIGIN=
RECHARGE_ENABLED=false
RECHARGE_CHECKOUT_ENABLED=false
RECHARGE_API_BASE=
RECHARGE_PARTNER_ID=
RECHARGE_KEY_ID=
RECHARGE_CLIENT_SECRET_FILE=/run/integrations/recharge-client
RECHARGE_PRODUCT_MAP={}
RECHARGE_NOTIFY_URL=
RECHARGE_WEBHOOK_SECRET_FILE=/run/integrations/recharge-webhook
RECHARGE_COLLECTION_MODE=platform_collect
# Enable after local acceptance and successful real-session verification.
SESSION_PRECHECK_ENABLED=false
SESSION_PRECHECK_URL=
SESSION_PRECHECK_SECRET_FILE=/run/integrations/session-precheck
EMAIL_PRODUCTS_ENABLED=false
ACCOUNT_SUPPLIER_ENABLED=false
ACCOUNT_SUPPLIER_CHECKOUT_ENABLED=false
ACCOUNT_SUPPLIER_API_BASE=
ACCOUNT_SUPPLIER_APP_ID=
ACCOUNT_SUPPLIER_APP_SECRET_FILE=/run/integrations/account_supplier
ACCOUNT_SUPPLIER_GOODS_ID=
ACCOUNT_SUPPLIER_MAX_COST_CENTS=
DELIVERY_SUPPLIER_ENABLED=false
DELIVERY_SUPPLIER_CHECKOUT_ENABLED=false
DELIVERY_SUPPLIER_API_KEY_FILE=/run/integrations/delivery_supplier
DELIVERY_SUPPLIER_CNY_PER_USD=
XGIFT_BACKEND=legacy
XGIFT_CHECKOUT_ENABLED=false
XGIFT_ENABLED=false
XGIFT_API_BASE=
XGIFT_USER_ID=
XGIFT_KEY_ID=
XGIFT_CLIENT_SECRET_FILE=/run/integrations/xgift-legacy
XGIFT_PLATFORM_ENABLED=false
XGIFT_PLATFORM_API_BASE=
XGIFT_PLATFORM_KEY_ID=
XGIFT_PLATFORM_CLIENT_SECRET_FILE=/run/integrations/xgift-platform
TELEGRAM_ENABLED=false
# Stop new bot applications while keeping moderation and existing invitations active.
TELEGRAM_REGISTRATION_CLOSED=false
TELEGRAM_BOT_TOKEN_FILE=/run/integrations/telegram-bot
TELEGRAM_WEBHOOK_SECRET_FILE=/run/integrations/telegram-webhook
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOWED_GROUP_IDS=
FEISHU_PAYOUT_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET_FILE=/run/integrations/feishu
FEISHU_PAYOUT_RECIPIENT=
